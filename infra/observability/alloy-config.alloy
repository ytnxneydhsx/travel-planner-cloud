local.file_match "travel_service_logs" {
  path_targets = [
    {
      "__path__"       = "/var/log/travel-planner/*/app.log",
      "job"            = "travel-planner-cloud",
      "compose_project" = "nacos",
      "platform"       = "file",
    },
  ]
  sync_period = "10s"
}

discovery.relabel "travel_service_logs" {
  targets = local.file_match.travel_service_logs.targets

  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/travel-planner/([^/]+)/app\\.log"
    target_label  = "service"
    replacement   = "$1"
  }
}

loki.source.file "travel_service_logs" {
  targets    = discovery.relabel.travel_service_logs.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
